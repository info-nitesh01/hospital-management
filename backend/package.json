{
  "name": "docu-backend",
  "version": "1.0.0",
  "description": "Node.js backend for the Docu app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "seed:users": "ts-node src/scripts/seed-users.ts",
    "seed:clients": "ts-node src/scripts/seed-clients.ts",
    "seed:client-workspaces": "ts-node src/scripts/seed-client-workspaces.ts",
    "seed:dashboard": "ts-node src/scripts/seed-dashboard.ts",
    "seed:themes": "ts-node src/scripts/seed-themes.ts"
  },
  "keywords": [
    "express",
    "backend",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
